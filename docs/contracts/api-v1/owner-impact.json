{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner-impact.json",
  "title": "Each island and ISO week holding a stored rating, with its ratings by value and the credit rows and gaps they recorded, owner only (#344)",
  "type": "object",
  "required": ["impact"],
  "additionalProperties": false,
  "properties": {
    "impact": {
      "type": "object",
      "required": ["items", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["island", "iso_week", "ratings", "likes", "dislikes", "skips", "credits", "genomes_credited", "credit_gaps"],
            "additionalProperties": false,
            "properties": {
              "island": {"$ref": "common.json#/$defs/island"},
              "iso_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
              "ratings": {"type": "integer", "minimum": 0},
              "likes": {"type": "integer", "minimum": 0},
              "dislikes": {"type": "integer", "minimum": 0},
              "skips": {"type": "integer", "minimum": 0},
              "credits": {"type": "integer", "minimum": 0},
              "genomes_credited": {"type": "integer", "minimum": 0},
              "credit_gaps": {"type": "integer", "minimum": 0}
            }
          }
        },
        "next_cursor": {"type": "null"}
      }
    }
  }
}
