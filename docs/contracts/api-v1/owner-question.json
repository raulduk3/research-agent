{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner-question.json",
  "title": "One question's stored definition, the runs that forecast it and the current resolution of each resolved forecast, owner only (#344)",
  "type": "object",
  "required": ["question_id", "target_definition_hash", "resolver_id", "resolver_version", "horizon", "sheets", "runs", "resolutions"],
  "additionalProperties": false,
  "properties": {
    "question_id": {"$ref": "common.json#/$defs/uuid"},
    "target_definition_hash": {"$ref": "common.json#/$defs/sha256"},
    "resolver_id": {"type": "string", "minLength": 1},
    "resolver_version": {"type": "integer", "minimum": 0},
    "horizon": {"$ref": "common.json#/$defs/utc_instant"},
    "sheets": {"type": "integer", "minimum": 1},
    "runs": {
      "type": "object",
      "required": ["items", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run_id", "configuration_id", "probability", "accepted_at"],
            "additionalProperties": false,
            "properties": {
              "run_id": {"$ref": "common.json#/$defs/uuid"},
              "configuration_id": {"$ref": "common.json#/$defs/uuid"},
              "probability": {"type": "number", "minimum": 0},
              "accepted_at": {"$ref": "common.json#/$defs/utc_instant"}
            }
          }
        },
        "next_cursor": {"type": "null"}
      }
    },
    "resolutions": {
      "type": "object",
      "required": ["items", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["forecast_id", "status", "resolution_version", "resolved_at"],
            "additionalProperties": false,
            "properties": {
              "forecast_id": {"$ref": "common.json#/$defs/uuid"},
              "status": {"enum": ["true", "false", "unresolvable"]},
              "resolution_version": {"type": "integer", "minimum": 1},
              "resolved_at": {"$ref": "common.json#/$defs/utc_instant"}
            }
          }
        },
        "next_cursor": {"type": "null"}
      }
    }
  }
}
