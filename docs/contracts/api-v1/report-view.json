{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-view.json",
  "title": "The weekly island report page (FT-26)",
  "description": "report is measurement/weekly.py#IslandReport field for field.",
  "type": "object",
  "required": ["notice", "report", "comparator_names"],
  "additionalProperties": false,
  "properties": {
    "notice": {"$ref": "common.json#/$defs/notice"},
    "comparator_names": {
      "type": "object",
      "required": ["random_control", "service"],
      "additionalProperties": false,
      "properties": {
        "random_control": {"type": "string"},
        "service": {"type": "string"}
      }
    },
    "report": {
      "type": "object",
      "required": [
        "island",
        "iso_week",
        "rows",
        "preference_reason",
        "comparisons",
        "migrations"
      ],
      "additionalProperties": false,
      "properties": {
        "island": {"$ref": "common.json#/$defs/island"},
        "iso_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/genome_row"}},
        "preference_reason": {"type": ["string", "null"]},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
        "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}}
      }
    }
  },
  "$defs": {
    "genome_row": {
      "type": "object",
      "required": [
        "genome_hash",
        "founder",
        "skills",
        "preference_credit",
        "credited_entries"
      ],
      "additionalProperties": false,
      "properties": {
        "genome_hash": {"$ref": "common.json#/$defs/sha256"},
        "founder": {"type": "boolean"},
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_id", "skill", "support_count", "disposition"],
            "additionalProperties": false,
            "properties": {
              "target_id": {"type": "string"},
              "skill": {"type": ["number", "null"]},
              "support_count": {"type": "integer", "minimum": 0},
              "disposition": {"type": "string"}
            }
          }
        },
        "preference_credit": {"type": "number"},
        "credited_entries": {"type": "integer", "minimum": 0}
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "comparator",
        "population_likes",
        "population_decided",
        "comparator_likes",
        "comparator_decided",
        "population_rate",
        "comparator_rate",
        "weeks",
        "interval",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "comparator": {"enum": ["random_control", "service"]},
        "population_likes": {"type": "integer", "minimum": 0},
        "population_decided": {"type": "integer", "minimum": 0},
        "comparator_likes": {"type": "integer", "minimum": 0},
        "comparator_decided": {"type": "integer", "minimum": 0},
        "population_rate": {"type": ["number", "null"]},
        "comparator_rate": {"type": ["number", "null"]},
        "weeks": {"type": "integer", "minimum": 0},
        "interval": {
          "type": "object",
          "required": [
            "method",
            "method_version",
            "resamples",
            "seed",
            "lower_tail",
            "upper_tail",
            "support_count",
            "support_hash",
            "estimate",
            "low",
            "high",
            "disposition"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string"},
            "method_version": {"type": "integer"},
            "resamples": {"type": "integer", "minimum": 0},
            "seed": {"type": "integer"},
            "lower_tail": {"type": "number"},
            "upper_tail": {"type": "number"},
            "support_count": {"type": "integer", "minimum": 0},
            "support_hash": {"type": "string"},
            "estimate": {"type": ["number", "null"]},
            "low": {"type": ["number", "null"]},
            "high": {"type": ["number", "null"]},
            "disposition": {"type": "string"}
          }
        },
        "verdict": {
          "type": "object",
          "required": [
            "verdict",
            "low",
            "high",
            "favorable_direction",
            "minimum_effect",
            "minimum_effect_pass"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {"type": "string"},
            "low": {"type": ["number", "null"]},
            "high": {"type": ["number", "null"]},
            "favorable_direction": {"type": "string"},
            "minimum_effect": {"type": ["number", "null"]},
            "minimum_effect_pass": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": ["child_hash", "source_island", "source_hash"],
      "additionalProperties": false,
      "properties": {
        "child_hash": {"$ref": "common.json#/$defs/sha256"},
        "source_island": {"$ref": "common.json#/$defs/island"},
        "source_hash": {"$ref": "common.json#/$defs/sha256"}
      }
    }
  }
}
