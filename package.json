{
  "name": "research-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": "1.3.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "version": "bun run scripts/version.ts",
    "check:hygiene": "bun run scripts/checks/hygiene.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run check:hygiene && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0"
  }
}
