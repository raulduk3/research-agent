# Rendered by platform/ingress.py#render_caddyfile; tests compare it.
{
	auto_https off
	admin off
	persist_config off
}

http://{$RESEARCH_AGENT_PUBLIC_HOSTNAME}:8480 {
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	handle /ingress/health {
		respond 200
	}
	handle /api/v1/* {
		reverse_proxy https://owner:8443 {
			transport http {
				tls_trust_pool file /run/secrets/ingress_ca
				tls_server_name owner
			}
		}
	}
	handle /* {
		reverse_proxy https://owner:8443 {
			transport http {
				tls_trust_pool file /run/secrets/ingress_ca
				tls_server_name owner
			}
		}
	}
}

http://:8480 {
	handle /ingress/health {
		respond 200
	}
	handle {
		respond 404
	}
}
