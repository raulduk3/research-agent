# Swarm beta environment. Copy to .env, fill in, keep it out of version control.
# Every value below is a placeholder.

# --- Public name (compose only) ----------------------------------------------
# The DNS name the proxy in compose.yaml serves and gets a certificate for.
API_HOST=api.example.org

# --- Store -----------------------------------------------------------------
# The one SQLite file that holds every durable record.
RESEARCH_AGENT_BETA_DB=/var/lib/swarm/swarm.sqlite3

# --- Sessions --------------------------------------------------------------
# Signs session tokens. Without it every restart signs with a new secret and
# signs everyone out. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
RESEARCH_AGENT_SESSION_SECRET=
# One shared credential per island, island:credential, comma separated. An
# island left out cannot be signed in to. Each credential must be different.
RESEARCH_AGENT_ISLAND_PASSWORDS=cs:change-me-cs,quant:change-me-quant,bio:change-me-bio,general:change-me-general
# The operator's credential: signs in to the app as operator, and is accepted
# as a bearer token by ingestion, advance, budget and spec edits.
RESEARCH_AGENT_OPERATOR_TOKEN=

# --- Browser origins (CORS) --------------------------------------------------
# Exact origins of the front end, comma separated. A wildcard is refused.
RESEARCH_AGENT_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: a pattern for preview deployments.
# RESEARCH_AGENT_ALLOWED_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# --- Model provider ----------------------------------------------------------
# One OpenAI-compatible chat-completions route. Set all five or none: with
# none, the app serves stored data and refuses runs; with some, it refuses to
# start. Prices are USD per million tokens and are what receipts are computed
# from, so take them from the provider's price list. There are no defaults.
RESEARCH_AGENT_MODEL_ENDPOINT=
RESEARCH_AGENT_MODEL_API_KEY=
RESEARCH_AGENT_MODEL_ID=
RESEARCH_AGENT_MODEL_INPUT_USD_PER_MTOK=
RESEARCH_AGENT_MODEL_OUTPUT_USD_PER_MTOK=
# A label for receipts.
RESEARCH_AGENT_MODEL_PROVIDER=
# Set to false if the provider rejects max_tokens.
RESEARCH_AGENT_MODEL_SEND_MAX_TOKENS=true

# --- Self-driving ------------------------------------------------------------
# Seconds between ingestion passes the process starts itself (0 = off; use the
# operator endpoint or the command line instead). 21600 is every six hours.
RESEARCH_AGENT_INGEST_SECONDS=21600
# Seconds between advances, when idle agents take their next papers (0 = off).
RESEARCH_AGENT_TICK_SECONDS=300

# The budget (50 USD a month by default), the islands and the agents are not
# set here. They live in the swarm spec and are edited from the app or with
# `python -m research_agent.beta spec`, each edit as a restorable revision.
