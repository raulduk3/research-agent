#!/usr/bin/env python3
"""Check local documentation links and self-contained contract text."""
from __future__ import annotations

from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent
LINK = re.compile(r"\]\(([^)\n]+)\)")
REFERENCE = re.compile(r"^\s{0,3}\[[^]\n]+\]:\s*(\S+)", re.M)
INLINE_DOCUMENT = re.compile(r"`((?:docs/|front-end/)[^`\s]+\.(?:md|html))(?:#[^`]*)?`")


def main() -> int:
    names = subprocess.check_output(
        ['git', 'ls-files', '--cached', '--others', '--exclude-standard', '*.md'],
        cwd=ROOT, text=True,
    ).splitlines()
    errors: list[str] = []
    for name in sorted(set(names)):
        document = ROOT / name
        if not document.exists():
            continue
        text = document.read_text()
        if re.search(r"#\d+\b|https://github\.com/[^\s)]+/(?:issues|pull)/", text):
            errors.append(f'{name}: documentation must state contracts without external work-tracking references')
        for match in INLINE_DOCUMENT.finditer(text):
            if not (ROOT / match[1]).is_file():
                line = text[:match.start()].count('\n') + 1
                errors.append(f'{name}:{line}: missing inline document {match[1]}')
        for match in (*LINK.finditer(text), *REFERENCE.finditer(text)):
            target = match[1].strip().split()[0].strip('<>')
            url = urlsplit(target)
            if url.scheme or target.startswith('/') or not url.path:
                continue
            path = document.parent / unquote(url.path)
            if not path.exists():
                line = text[:match.start()].count('\n') + 1
                errors.append(f'{name}:{line}: missing link target {target}')
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        return 1
    print('Documentation links and self-contained contract text pass.')
    return 0


def self_test() -> int:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / 'bin').mkdir()
        script = root / 'bin/doc-check'
        script.write_text(Path(__file__).read_text())
        subprocess.run(['git', 'init', '-q', directory], check=True)
        (root / 'README.md').write_text('[Design](TDD.md)\n')
        (root / 'TDD.md').write_text('# Architecture\n')
        def check(expected: int, message: str = '') -> None:
            result = subprocess.run([sys.executable, str(script)], capture_output=True, text=True)
            assert result.returncode == expected, result.stdout + result.stderr
            assert message in result.stderr, result.stderr
        check(0)
        (root / 'README.md').write_text('[Design](missing.md)\n')
        check(1, 'missing link target missing.md')
        (root / 'README.md').write_text('See issue #123 for the contract.\n')
        check(1, 'without external work-tracking references')
        (root / 'README.md').write_text('See owner/project#123 for the contract.\n')
        check(1, 'without external work-tracking references')
        (root / 'README.md').write_text('[Design][contract]\n\n[contract]: missing.md\n')
        check(1, 'missing link target missing.md')
        (root / 'README.md').write_text('See `docs/missing.md` for the contract.\n')
        check(1, 'missing inline document docs/missing.md')
        (root / 'README.md').write_text('[Design](TDD.md)\n')
    print('Documentation self-test: broken links and external work-tracking references rejected.')
    return 0


if __name__ == '__main__':
    sys.exit(self_test() if '--self-test' in sys.argv else main())
