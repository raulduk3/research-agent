#!/usr/bin/env python3
"""Check local documentation links and specification owner references."""
from __future__ import annotations

import ast
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent
LINK = re.compile(r"\]\(([^)\n]+)\)")
REFERENCE = re.compile(r"^\s{0,3}\[[^]\n]+\]:\s*(\S+)", re.M)
INLINE_DOCUMENT = re.compile(r"`((?:docs/|front-end/)[^`\s]+\.(?:md|html))(?:#[^`]*)?`")
TRACE = re.compile(r"^<!--\s*id:\s*TDD-[^|]+\|\s*implements:\s*[^|]+\|\s*code:\s*([^|]+)\|\s*tests:\s*([^|]+)\|", re.M)


def prose(text: str) -> str:
    """Preserve line numbers while excluding fenced examples from owner checks."""
    lines: list[str] = []
    fence = ''
    for line in text.splitlines(keepends=True):
        marker = re.match(r'^\s*(`{3,}|~{3,})', line)
        if marker:
            if not fence:
                fence = marker[1]
            elif marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = ''
            lines.append('\n')
        else:
            lines.append('\n' if fence else line)
    return ''.join(lines)


def main() -> int:
    names = subprocess.check_output(
        ['git', 'ls-files', '--cached', '--others', '--exclude-standard', '*.md'],
        cwd=ROOT, text=True,
    ).splitlines()
    errors: list[str] = []
    for name in sorted(set(names)):
        document = ROOT / name
        if not document.exists():
            continue
        text = document.read_text()
        if re.search(r"#\d+\b|https://github\.com/[^\s)]+/(?:issues|pull)/", text):
            errors.append(f'{name}: documentation must state contracts without external work-tracking references')
        for match in INLINE_DOCUMENT.finditer(text):
            if not (ROOT / match[1]).is_file():
                line = text[:match.start()].count('\n') + 1
                errors.append(f'{name}:{line}: missing inline document {match[1]}')
        for match in (*LINK.finditer(text), *REFERENCE.finditer(text)):
            target = match[1].strip().split()[0].strip('<>')
            url = urlsplit(target)
            if url.scheme or target.startswith('/') or not url.path:
                continue
            path = document.parent / unquote(url.path)
            if not path.exists():
                line = text[:match.start()].count('\n') + 1
                errors.append(f'{name}:{line}: missing link target {target}')
    for match in TRACE.finditer(prose((ROOT / 'TDD.md').read_text())):
        code, tests = (value.strip() for value in match.groups())
        path, _, symbol = code.partition('#')
        owner = ROOT / path
        if not owner.is_file():
            errors.append(f'TDD.md: missing code owner {code}')
        elif symbol:
            content = owner.read_text()
            if owner.suffix == '.py':
                body = ast.parse(content).body
                present = True
                for part in symbol.split('.'):
                    definition = next((node for node in body if isinstance(node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == part), None)
                    if definition is None:
                        present = False
                        break
                    body = definition.body
            else:
                present = bool(re.search(r'\b(?:function|class|const|let|type|interface)\s+' + re.escape(symbol) + r'\b', content))
            if not present:
                errors.append(f'TDD.md: missing code symbol {code}')
        if tests != 'none' and not (ROOT / tests).is_file():
            errors.append(f'TDD.md: missing test owner {tests}')
    for directory in ('docs/archive', 'docs/decisions', 'docs/evidence', 'front-end/design-mock', 'docs/implementation'):
        for path in (ROOT / directory).rglob('*.md'):
            errors.append(f'{path.relative_to(ROOT)}: historical notes belong in Git history; current contracts belong in root SDD.md and TDD.md')
    for name in ('SPEC-AMENDMENTS.md', 'docs/DEVELOPMENT.md'):
        if (ROOT / name).exists():
            errors.append(f'{name}: historical ledgers belong in Git history')
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        return 1
    print('Documentation links, specification owners and current contract layout pass.')
    return 0


def self_test() -> int:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / 'bin').mkdir()
        script = root / 'bin/doc-check'
        script.write_text(Path(__file__).read_text())
        subprocess.run(['git', 'init', '-q', directory], check=True)
        (root / 'README.md').write_text('[Design](TDD.md)\n')
        trace = '<!-- id: TDD-1.1.1 | implements: CP-01 | code: owner.py#Owner.read | tests: test_owner.py | status: implemented -->\n'
        (root / 'TDD.md').write_text(trace)
        (root / 'owner.py').write_text('class Owner:\n    def read(self):\n        return 1\n')
        (root / 'test_owner.py').touch()
        def check(expected: int, message: str = '') -> None:
            result = subprocess.run([sys.executable, str(script)], capture_output=True, text=True)
            assert result.returncode == expected, result.stdout + result.stderr
            assert message in result.stderr, result.stderr
        check(0)
        (root / 'README.md').write_text('[Design](missing.md)\n')
        check(1, 'missing link target missing.md')
        (root / 'README.md').write_text('See issue #123 for the contract.\n')
        check(1, 'without external work-tracking references')
        (root / 'README.md').write_text('See owner/project#123 for the contract.\n')
        check(1, 'without external work-tracking references')
        (root / 'README.md').write_text('[Design][contract]\n\n[contract]: missing.md\n')
        check(1, 'missing link target missing.md')
        (root / 'README.md').write_text('See `docs/missing.md` for the contract.\n')
        check(1, 'missing inline document docs/missing.md')
        (root / 'README.md').write_text('[Design](TDD.md)\n')
        (root / 'TDD.md').write_text(trace.replace('Owner.read', 'Owner.missing'))
        check(1, 'missing code symbol owner.py#Owner.missing')
        (root / 'TDD.md').write_text(trace.replace('<!-- id:', '<!--  id:').replace('Owner.read', 'Owner.missing'))
        check(1, 'missing code symbol owner.py#Owner.missing')
        (root / 'TDD.md').write_text(trace + '\n```md\n' + trace.replace('Owner.read', 'Owner.missing') + '```\n')
        check(0)
        (root / 'TDD.md').write_text(trace)
        for directory in ('docs/archive', 'docs/decisions', 'docs/evidence', 'docs/implementation', 'front-end/design-mock'):
            notes = root / directory / 'notes.md'
            notes.parent.mkdir(parents=True, exist_ok=True)
            notes.touch()
            check(1, 'historical notes belong in Git history; current contracts belong in root SDD.md and TDD.md')
            notes.unlink()
        for name in ('SPEC-AMENDMENTS.md', 'docs/DEVELOPMENT.md'):
            ledger = root / name
            ledger.parent.mkdir(parents=True, exist_ok=True)
            ledger.touch()
            check(1, 'historical ledgers belong in Git history')
            ledger.unlink()
        check(0)
    print('Documentation self-test: broken links, tracker references, missing owners and scattered notes rejected.')
    return 0


if __name__ == '__main__':
    sys.exit(self_test() if '--self-test' in sys.argv else main())
