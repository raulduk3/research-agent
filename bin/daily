#!/bin/sh
# Issue one UTC day: list and acquire its papers, card them, seal its sheets
# and snapshot, draw each island's coverage sample and write one run record
# per sampled paper and active genome. Starts no run.
#   bin/daily --state DIR --dsn DSN --profile FILE \
#     (--bindings FILE | --agent-model-manifest SHA256 \
#      --image ROLE=SHA256 [--image ...] \
#      --index-identity SHA256 [--index-identity ...]) [--day YYYY-MM-DD] \
#     [--since YYYY-MM-DD] [--device cuda|mps|cpu] [--cache-dir DIR]
# `--bindings` takes bin/bindings' output in place of the three flags. The
# day's run ids are recorded in slot order for `bin/bindings --runs`.
# The state directory holds the daily ingest's watermark, artifacts and
# worker certificates (`python -m research_agent.ingest.daily`). A repeated
# day reuses the window it was first issued with and issues nothing new.
# It never migrates: run it under the runtime DSN once `migrate` and
# `check-schema` pass under the migrator's; a stale schema exits 1.
set -eu
cd "$(dirname "$0")/.."
exec uv run --locked python -m research_agent.orchestration.daily "$@"
