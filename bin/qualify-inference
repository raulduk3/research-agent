#!/usr/bin/env python3
"""Run the launch profile's agent-model qualification battery (Appendix A).

Three suites against the pinned hosted deployment (AG-01, TDD-3.1.37): 100
real five-tool/schema conversations with at least 99 valid complete
submissions and no successful forbidden tool; 50 preserved figure/table
questions with at least 80% correct; 100 evidence-location questions
balanced over early/middle/late positions in 16k/32k/64k contexts with at
least 90% correct at each length. Tool responses come from a fixture
dispatcher over a small synthetic corpus (a stand-in for #117's real tool
service, per the fixture population documented under
tests/qualification/inference/fixtures/); the model itself is the real
pinned endpoint unless --dry-run is given. Reads the provider key from the
environment only, reserves worst-case spend against the day/month caps
before each conversation, records every request/response by hash, and
writes an immutable report to docs/evidence/inference-capacity/.

No paid execution happens without an explicit --endpoint and a populated
provider key; --dry-run exercises the same mechanism against a synthetic
in-process transport and writes a clearly labeled report instead.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import uuid
from collections.abc import Callable, Sequence
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent

if __name__ == "__main__":
    try:
        import research_agent  # noqa: F401
    except ImportError:
        os.execvp("uv", ["uv", "run", "--locked", "python3", __file__, *sys.argv[1:]])

from research_agent.agents.budgets import (  # noqa: E402
    CONTEXT_TOKENS_LIMIT,
    GENERATION_TOKENS_LIMIT,
    MODEL_CALLS_LIMIT,
    TOOL_CALLS_LIMIT,
)
from research_agent.agents.client import (  # noqa: E402
    AGENT_MODEL_ID,
    AGENT_PROVIDER,
    UNPINNED_REVISION,
    AgentDeploymentManifest,
    ChatCompletionsTransport,
    PinnedModelClient,
    TurnUsage,
)
