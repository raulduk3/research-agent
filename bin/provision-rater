#!/bin/sh
# Provision one rater principal for the rating app (PL-22). Generates the
# rater's credential, writes it to a new owner-only file and prints the rater
# id and that file's path, never the credential; storage receives only the
# salted hash. An existing file is never overwritten: with --rater-id the
# rerun reads it and replays the stored provisioning, without it the command
# refuses. --island takes cs or quant-ph (quant_ph); q-bio waits on #371.
#   bin/provision-rater --island ISLAND --credential-file FILE [--rater-id UUID]
#     --storage-host HOST --storage-port PORT --storage-server-name NAME
#     --ca-file FILE --owner-cert FILE --owner-key FILE
set -eu
cd "$(dirname "$0")/.."
exec uv run --locked python -m research_agent.platform.raters "$@"
