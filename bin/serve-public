#!/bin/sh
# Publish the owner surfaces through one authenticated tunnel (decision 0030).
#   bin/serve-public --provider ngrok --profile PROFILE.json [--state-dir DIR]
#   bin/serve-public --stop [--state-dir DIR]
# Reads NGROK_AUTHTOKEN and NGROK_DOMAIN from the environment, never from a
# flag or a file. Refuses unless the domain is the profile's
# host.public_hostname, the ingress routes owner-authenticated surfaces
# alone and the tunnel, not the ingress, terminates TLS. Starts the ngrok
# client detached toward the ingress on 127.0.0.1:8480, records its process
# id in the state directory and prints the public URL; --stop ends it, and
# --stop then a start restarts it.
set -eu
cd "$(dirname "$0")/.."
exec uv run --locked python -m research_agent.platform.ingress "$@"
