#!/bin/sh
# Assemble and publish one versioned historical training corpus release.
#   bin/build-corpus run    --state DIR --dsn DSN --population-rule RULE \
#                            --representation-hash SHA256 [--purpose PURPOSE] \
#                            [--candidates FILE] [--prior-release-hash SHA256]
#   bin/build-corpus report --state DIR --dsn DSN --population-rule RULE \
#                            --representation-hash SHA256
# The DSN must select a dedicated schema; the state directory holds
# published artifacts and run measurements. Refuses to run without a
# configured population rule.
set -eu
cd "$(dirname "$0")/.."
exec uv run --locked python -m research_agent.learning.release "$@"
