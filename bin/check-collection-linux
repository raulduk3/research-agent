PROBE_IMAGE = "busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0"
ARTIFACT_ROOT = "/var/lib/research-agent/artifacts"
DOCKER_SOCKET = "/var/run/docker.sock"
SCHEMA = "research_agent"
LISTENER_PORT = "9000"
INTERNET_ADDRESS = "1.1.1.1"
INTERNET_PORT = "443"

PROVISION = r"""from __future__ import annotations
