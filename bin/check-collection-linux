    connection.execute(sql.SQL("CREATE ROLE {} LOGIN PASSWORD {} NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS").format(sql.Identifier(login), sql.Literal(password)))
    connection.execute(sql.SQL("GRANT {} TO {}").format(sql.Identifier(application), sql.Identifier(login)))
runtime = make_conninfo(host="postgres", port=5432, dbname=(root / "postgres_database").read_text().strip(), user=login, password=password, options=f"-csearch_path={schema} -crole={application}")
target = root / "storage_dsn"
target.write_text(runtime)
target.chmod(0o644)
"""

# Write and read one disposable ledger record through the real repository, so
# a preserved-volume recreation can be compared byte-for-byte (TDD-2.1.45).
PERSIST_RECORD_ID = "00000000-0000-4000-8000-000000000001"
PERSIST_COMMAND_ID = "00000000-0000-4000-8000-000000000002"
PERSIST_WRITE = f"""from pathlib import Path
