class Unavailable(RuntimeError):
    """A prerequisite is missing, so the observation claims nothing."""


class Engine:
    """The explicitly selected Linux Docker engine and one Compose project."""

    def __init__(self, command: tuple[str, ...], project: str) -> None:
        self.command = command
        self.project = project
        self.environment: dict[str, str] = {}

    def run(
        self,
        *arguments: str,
        check: bool = True,
        timeout: int = 180,
        environment: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[str]:
        try:
            return subprocess.run(
                (*self.command, *arguments),
                check=check,
                capture_output=True,
                text=True,
                timeout=timeout,
                cwd=ROOT,
                env=None if environment is None else {**os.environ, **environment},
            )
        except subprocess.CalledProcessError as error:
            # Arguments can carry disposable secrets, so only the step and the
            # engine's own message are reported.
            raise Unavailable(
                f"docker {arguments[0]} failed: {error.stderr.strip()[-500:]}"
            ) from error

    def compose(
        self,
        *arguments: str,
        environment: dict[str, str] | None = None,
        timeout: int = 1800,
        check: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        return self.run(
            "compose",
            "--project-name",
            self.project,
            "--file",
            "compose.yaml",
            *arguments,
            environment={**self.environment, **(environment or {})},
            timeout=timeout,
            check=check,
        )

    def inspect(self, kind: str, name: str) -> dict[str, object]:
        return json.loads(self.run(kind, "inspect", name).stdout)[0]

    def project_resource(self, kind: str, service: str) -> str:
        """Name the network or volume Compose actually created for this run."""
        listing = self.run(
            kind,
            "ls",
            "--filter",
            f"label=com.docker.compose.project={self.project}",
            "--format",
            "{{.Name}}",
        ).stdout.split()
        matches = [name for name in listing if name.endswith(service)]
        if len(matches) != 1:
            raise Unavailable(f"compose {kind} {service} was not created exactly once")
        return matches[0]


def openssl(*arguments: str) -> None:
    subprocess.run(("openssl", *arguments), check=True, capture_output=True)


def write_fixture(fixture: Path) -> dict[str, str]:
    """Generate the disposable deployment inputs the pinned stack requires."""
    fixture.chmod(0o755)
    certificate = fixture / "tls.pem"
    key = fixture / "tls.key"
    authority = fixture / "client-ca.pem"
    openssl(
        "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1",
        "-subj", "/CN=storage", "-addext", "subjectAltName=DNS:storage",
        "-keyout", str(key), "-out", str(certificate),
    )
    openssl(
        "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1",
        "-subj", "/CN=boundary-client-ca",
        "-keyout", str(fixture / "client-ca.key"), "-out", str(authority),
    )
    openssl(
        "req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=boundary-client",
        "-keyout", str(fixture / "client.key"), "-out", str(fixture / "client.csr"),
    )
    openssl(
        "x509", "-req", "-days", "1", "-in", str(fixture / "client.csr"),
        "-CA", str(authority), "-CAkey", str(fixture / "client-ca.key"),
        "-CAcreateserial", "-out", str(fixture / "client.pem"),
    )
    identity = hashlib.sha256(
        ssl.PEM_cert_to_DER_cert((fixture / "client.pem").read_text())
    ).hexdigest()
    values = {
        "postgres_database": "research_agent",
        "postgres_user": "boundary_admin",
        "postgres_password": secrets.token_hex(24),
        "storage_dsn": "pending",
    }
    for name, value in values.items():
        (fixture / name).write_text(value)
    configuration = {
        "database_dsn_file": "/run/secrets/storage_dsn",
        "artifact_root": ARTIFACT_ROOT,
        "schema": SCHEMA,
        "host": "0.0.0.0",
        "port": 8443,
        "tls": {
            "certificate_file": "/run/secrets/storage_tls_certificate",
            "private_key_file": "/run/secrets/storage_tls_private_key",
            "client_ca_file": "/run/secrets/storage_tls_client_ca",
        },
        "producer": {
            "image_digest": "0" * 64,
            "source_commit": "0" * 40,
            "contract_version": 1,
        },
        "config_hash": "0" * 64,
        "retention_policy_hash": "0" * 64,
        "capabilities": {
            identity: {
                "principal_id": str(uuid.uuid4()),
                "role": "ingest",
                "scopes": ["jobs:claim"],
                "job_kinds": ["capture"],
                "producer_version": {
                    "image_digest": "0" * 64,
                    "source_commit": "0" * 40,
                    "contract_version": 1,
                },
                "config_hash": "0" * 64,
                "retention_policy_hash": "0" * 64,
            }
        },
    }
    (fixture / "storage.json").write_text(json.dumps(configuration))
    for path in fixture.iterdir():
        path.chmod(0o644)
    return {
        "RESEARCH_AGENT_STORAGE_CONFIG": str(fixture / "storage.json"),
        "RESEARCH_AGENT_POSTGRES_DATABASE_FILE": str(fixture / "postgres_database"),
        "RESEARCH_AGENT_POSTGRES_USER_FILE": str(fixture / "postgres_user"),
        "RESEARCH_AGENT_POSTGRES_PASSWORD_FILE": str(fixture / "postgres_password"),
        "RESEARCH_AGENT_STORAGE_DSN_FILE": str(fixture / "storage_dsn"),
        "RESEARCH_AGENT_STORAGE_TLS_CERTIFICATE_FILE": str(certificate),
        "RESEARCH_AGENT_STORAGE_TLS_PRIVATE_KEY_FILE": str(key),
        "RESEARCH_AGENT_STORAGE_TLS_CLIENT_CA_FILE": str(authority),
    }


def await_state(read: Callable[[], str], wanted: str, *, label: str) -> None:
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        if read() == wanted:
            return
        time.sleep(2)
    raise Unavailable(f"{label} never became {wanted}")


def start_stack(engine: Engine, fixture: Path) -> dict[str, str]:
    """Build and start the committed Compose stack with disposable inputs."""
    engine.environment = write_fixture(fixture)
    engine.compose("build")
    engine.compose("up", "--detach", "postgres")
    postgres = f"{engine.project}-postgres-1"
    await_state(
        lambda: str(engine.inspect("container", postgres)["State"]["Health"]["Status"]),
        "healthy",
        label="postgres",
    )
    (fixture / "provision.py").write_text(PROVISION)
    (fixture / "provision.py").chmod(0o644)
    engine.run(
        "run", "--rm", "--user", "0",
        "--network", engine.project_resource("network", "storage"),
        "--volume", f"{fixture}:/fixture",
        "--env", f"RA_SCHEMA={SCHEMA}",
        "--entrypoint", "/app/.venv/bin/python",
        f"{engine.project}-storage",
        "/fixture/provision.py",
        timeout=300,
    )
    engine.compose("up", "--detach", "storage")
    storage = f"{engine.project}-storage-1"
    try:
        await_state(
            lambda: str(engine.inspect("container", storage)["State"]["Status"]),
            "running",
            label="storage",
        )
    except Unavailable as error:
        logs = engine.run("logs", "--tail", "20", storage, check=False)
        raise Unavailable(f"{error}: {logs.stderr.strip()[-500:]}") from error
    return engine.environment


def address(engine: Engine, container: str, network: str) -> str:
    record = engine.inspect("container", container)
    networks = record["NetworkSettings"]["Networks"]  # type: ignore[index]
    return str(networks[network]["IPAddress"])


def reaches(engine: Engine, container: str, host: str, port: str) -> bool:
    """One real TCP connection attempt from inside a running container."""
    result = engine.run(
        "exec", container, "nc", "-z", "-w", "3", host, port, check=False, timeout=60
    )
    return result.returncode == 0


def exists(engine: Engine, container: str, path: str) -> bool:
    return engine.run("exec", container, "test", "-e", path, check=False).returncode == 0


def worker_boundary() -> int:
    """Observe the worker role's reach against the running pinned stack."""
    if platform.system() != "Linux":
        return report("linux_host")
    command = os.environ.get("RESEARCH_AGENT_CONTAINER_DOCKER")
    if not command:
        return report("explicit disposable Linux Docker command is required")
    token = uuid.uuid4().hex[:8]
    engine = Engine(tuple(shlex.split(command)), f"raboundary{token}")
    worker_network = f"research-agent-workers-{token}"
    external_network = f"research-agent-unlisted-{token}"
    worker = f"research-agent-worker-{token}"
    allowed = f"research-agent-allowed-{token}"
    listener = f"research-agent-listener-{token}"
    external = f"research-agent-external-{token}"
    internet = f"research-agent-internet-{token}"
    containers = (worker, allowed, listener, external, internet)
    try:
        if engine.run("info", "--format", "{{.OSType}}").stdout.strip() != "linux":
            raise Unavailable("docker daemon is not Linux")
        with tempfile.TemporaryDirectory(prefix="research-agent-boundary-") as directory:
            fixture = Path(directory)
            start_stack(engine, fixture)
            observe(
                engine,
                worker_network=worker_network,
                external_network=external_network,
                names=containers,
            )
            engine.compose(
                "down", "--volumes", "--remove-orphans", timeout=300, check=False
            )
    except Unavailable as error:
        return report(str(error))
    except RuntimeError as error:
        # A control was live and the worker still reached it: state the breach.
        print(f"Collection boundary violated: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, KeyError, IndexError, json.JSONDecodeError) as error:
        return report(f"worker_boundary ({error})")
    finally:
        for name in containers:
            engine.run("rm", "--force", name, check=False)
        for network in (worker_network, external_network):
            engine.run("network", "rm", network, check=False)
        engine.compose("down", "--volumes", "--remove-orphans", timeout=300, check=False)
    return 0


def serving(engine: Engine, prober: str, container: str) -> bool:
    """Give the started service time to bind before believing a refusal."""
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        if str(engine.inspect("container", container)["State"]["Status"]) != "running":
            logs = engine.run("logs", "--tail", "10", container, check=False)
            raise Unavailable(
                f"storage stopped serving: {(logs.stdout + logs.stderr).strip()[-400:]}"
            )
        if reaches(engine, prober, "storage", "8443"):
            return True
        time.sleep(3)
    return False


def observe(
    engine: Engine,
    *,
    worker_network: str,
    external_network: str,
    names: tuple[str, ...],
) -> None:
    """Compare what an allowed peer reaches with what a worker container does."""
    worker, allowed, listener, external, internet = names
    storage_network = engine.project_resource("network", "storage")
    artifacts = engine.project_resource("volume", "artifact-data")
    postgres_container = f"{engine.project}-postgres-1"
    storage_container = f"{engine.project}-storage-1"
    engine.run("network", "create", "--internal", worker_network)
    engine.run("network", "create", external_network)
    engine.run(
        "run", "--detach", "--name", listener, "--network", external_network,
        PROBE_IMAGE, "sh", "-c", f"while true; do nc -lp {LISTENER_PORT}; done",
    )
    engine.run("run", "--detach", "--name", external, "--network", external_network, PROBE_IMAGE, "sleep", "900")
    engine.run("run", "--detach", "--name", internet, PROBE_IMAGE, "sleep", "900")
    engine.run(
        "run", "--detach", "--name", allowed, "--network", storage_network,
        "--volume", f"{artifacts}:{ARTIFACT_ROOT}", PROBE_IMAGE, "sleep", "900",
    )
    # The worker gets what an agent run is declared to get: its own network,
    # no mount, no socket.
    engine.run("run", "--detach", "--name", worker, "--network", worker_network, PROBE_IMAGE, "sleep", "900")

    marker = f"{ARTIFACT_ROOT}/boundary-marker"
    engine.run("exec", allowed, "sh", "-c", f"echo authoritative > {marker}")
    listener_address = address(engine, listener, external_network)
    postgres_address = address(engine, postgres_container, storage_network)
    storage_address = address(engine, storage_container, storage_network)

    live = (
        ("control_postgres_5432", "reachable", reaches(engine, allowed, "postgres", "5432")),
        ("control_storage_8443", "reachable", serving(engine, allowed, storage_container)),
        ("control_artifact_marker", "readable", exists(engine, allowed, marker)),
        ("control_unlisted_listener", "reachable", reaches(engine, external, listener_address, LISTENER_PORT)),
        ("control_internet_443", "reachable", reaches(engine, internet, INTERNET_ADDRESS, INTERNET_PORT)),
    )
    for label, state, observed in live:
        if not observed:
            raise Unavailable(f"{label} is not live, so a worker refusal would prove nothing")
        print(f"{label}: {state}")

    denied = (
        ("worker_postgres_by_name", reaches(engine, worker, "postgres", "5432")),
        ("worker_postgres_by_address", reaches(engine, worker, postgres_address, "5432")),
        ("worker_storage_by_address", reaches(engine, worker, storage_address, "8443")),
        ("worker_unlisted_listener", reaches(engine, worker, listener_address, LISTENER_PORT)),
        ("worker_internet_443", reaches(engine, worker, INTERNET_ADDRESS, INTERNET_PORT)),
    )
    for label, observed in denied:
        if observed:
            raise RuntimeError(f"{label}: the worker container reached a closed destination")
        print(f"{label}: denied")

    absent = (
        ("worker_artifact_root", exists(engine, worker, ARTIFACT_ROOT)),
        ("worker_artifact_marker", exists(engine, worker, marker)),
        ("worker_docker_socket", exists(engine, worker, DOCKER_SOCKET)),
        ("worker_docker_client", engine.run("exec", worker, "sh", "-c", "command -v docker", check=False).returncode == 0),
    )
    for label, observed in absent:
        if observed:
            raise RuntimeError(f"{label}: the worker container holds what it must not")
        print(f"{label}: absent")

    worker_record = engine.inspect("container", worker)
    if worker_record["Mounts"] or worker_record["HostConfig"]["Binds"]:  # type: ignore[index]
        raise RuntimeError("worker_mounts: the worker container holds a mount")
    print("worker_mounts: none")

    for service, container in (("postgres", postgres_container), ("storage", storage_container)):
        record = engine.inspect("container", container)
        host_config = record["HostConfig"]  # type: ignore[index]
        destinations = sorted(str(mount["Destination"]) for mount in record["Mounts"])  # type: ignore[index]
        binds = tuple(host_config["Binds"] or ())
        if DOCKER_SOCKET in destinations or any(DOCKER_SOCKET in bind for bind in binds):
            raise RuntimeError(f"compose_{service}: the service holds a Docker socket")
        if host_config["ReadonlyRootfs"] is not True:
            raise RuntimeError(f"compose_{service}: the service root filesystem is writable")
        print(f"compose_{service}: read_only, no docker socket, mounts={destinations}")

    for label, network in (("storage", storage_network), ("worker", worker_network)):
        if engine.inspect("network", network)["Internal"] is not True:
            raise RuntimeError(f"{label}_network: the network is not internal")
        print(f"{label}_network: internal")

    image = engine.inspect("image", f"{engine.project}-storage")
    print(
        "Collection worker boundary probe passed: "
        f"project={engine.project} storage_image={image['Id']} "
        f"architecture={image['Architecture']}/{image['Os']}"
    )


def _run_bytes(command: tuple[str, ...], *, timeout: int = 600) -> bytes:
    """One raw-bytes subprocess call; Engine.run always decodes as text."""
    return subprocess.run(
        command, check=True, capture_output=True, timeout=timeout, cwd=ROOT
    ).stdout


def _image_export_bytes(engine: Engine, image: str) -> bytes:
    """Export one image's flattened filesystem as a tar byte string."""
    container = engine.run("create", image, "true").stdout.strip()
    try:
        return _run_bytes((*engine.command, "export", container), timeout=600)
    finally:
        engine.run("rm", "--force", container, check=False)


def _image_file_paths(engine: Engine, image: str) -> tuple[str, ...]:
    """List every regular file path an image's flattened filesystem holds."""
    with tarfile.open(fileobj=io.BytesIO(_image_export_bytes(engine, image))) as archive:
        return tuple("/" + member.name for member in archive.getmembers() if member.isfile())


def _run_in_storage_image(engine: Engine, fixture: Path, network: str, script: str) -> str:
    """Run one disposable Python script inside the built storage image."""
    script_path = fixture / f"script-{uuid.uuid4().hex[:8]}.py"
    script_path.write_text(script)
    script_path.chmod(0o644)
    result = engine.run(
        "run", "--rm", "--network", network,
        "--volume", f"{fixture}:/fixture",
        "--entrypoint", "/app/.venv/bin/python",
        f"{engine.project}-storage",
        f"/fixture/{script_path.name}",
        timeout=120,
    )
    return result.stdout


def secret_scan() -> int:
    """Prove no synthetic runtime secret reaches the built image, its build
    context, its history or the rendered Compose text (TDD-2.1.35)."""
    if platform.system() != "Linux":
        return report("linux_host")
    command = os.environ.get("RESEARCH_AGENT_CONTAINER_DOCKER")
    if not command:
        return report("explicit disposable Linux Docker command is required")
    from research_agent.platform.secrets import scan_for_secret_values

    token = uuid.uuid4().hex[:8]
    engine = Engine(tuple(shlex.split(command)), f"rasecrets{token}")
    canary = f"synthetic-secret-{secrets.token_hex(16)}"
    try:
        with tempfile.TemporaryDirectory(prefix="research-agent-secret-scan-") as directory:
            fixture = Path(directory)
            engine.environment = write_fixture(fixture)
            password = (fixture / "postgres_password").read_text()
            engine.compose("build")
            image = f"{engine.project}-storage"

            control = scan_for_secret_values({"control": canary.encode()}, (canary,))
            if control != ("control",):
                raise Unavailable("the scanner failed its own control detection")
            print("control_detection: caught")

            blobs: dict[str, bytes] = {
                "image_history": engine.run(
                    "history", "--no-trunc", "--format", "{{.CreatedBy}}", image
                ).stdout.encode(),
                "rendered_compose": engine.compose("config").stdout.encode(),
            }
            for name in ("pyproject.toml", "uv.lock", "Dockerfile"):
                blobs[f"build_context:{name}"] = (ROOT / name).read_bytes()
            for path in (ROOT / "src").rglob("*.py"):
                blobs[f"build_context:{path.relative_to(ROOT)}"] = path.read_bytes()
            blobs["image_filesystem"] = _image_export_bytes(engine, image)

            secret_values = (canary, password)
            hits = scan_for_secret_values(blobs, secret_values)
            if hits:
                raise RuntimeError(f"secret_scan: a synthetic secret leaked into {hits}")
            for label in blobs:
                print(f"{label}: clean")
            print("Collection secret scan probe passed")
    except Unavailable as error:
        return report(str(error))
    except RuntimeError as error:
        print(f"Collection boundary violated: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, KeyError, IndexError, json.JSONDecodeError, tarfile.TarError) as error:
        return report(f"secret_scan ({error})")
    finally:
        engine.compose("down", "--volumes", "--remove-orphans", timeout=300, check=False)
    return 0


def worker_image() -> int:
    """Inspect the built application image and its declared mounts against
    the weight-free worker admission policy (TDD-2.1.39). No worker-specific
    Compose service exists yet, so this checks the one image every future
    worker command would run from, and the mounts Compose declares today."""
    if platform.system() != "Linux":
        return report("linux_host")
    command = os.environ.get("RESEARCH_AGENT_CONTAINER_DOCKER")
    if not command:
        return report("explicit disposable Linux Docker command is required")
    from research_agent.platform.workers import VolumeMount, WorkerImagePolicy

    token = uuid.uuid4().hex[:8]
    engine = Engine(tuple(shlex.split(command)), f"raworkerimg{token}")
    try:
        with tempfile.TemporaryDirectory(prefix="research-agent-worker-image-") as directory:
            fixture = Path(directory)
            engine.environment = write_fixture(fixture)
            engine.compose("build")
            image_name = f"{engine.project}-storage"
            manifest = engine.inspect("image", image_name)
            environment = [str(item) for item in (manifest["Config"]["Env"] or ())]
            paths = _image_file_paths(engine, image_name)
            config = json.loads(engine.compose("config", "--format", "json").stdout)
            declared = config["services"]["storage"].get("volumes", [])
            mounts = tuple(
                VolumeMount(
                    destination=str(volume["target"]),
                    read_only=bool(volume.get("read_only", False)),
                )
                for volume in declared
                if isinstance(volume, dict) and "target" in volume
            )
            policy = WorkerImagePolicy()
            violations = policy.evaluate(image_paths=paths, mounts=mounts, environment=environment)
            if violations:
                raise RuntimeError(f"worker_image: {violations}")
            print(f"worker_image_paths_scanned: {len(paths)}")
            print(f"worker_image_mounts_scanned: {len(mounts)}")
            print("Collection worker image probe passed")
    except Unavailable as error:
        return report(str(error))
    except RuntimeError as error:
        print(f"Collection boundary violated: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, KeyError, IndexError, json.JSONDecodeError, tarfile.TarError) as error:
        return report(f"worker_image ({error})")
    finally:
        engine.compose("down", "--volumes", "--remove-orphans", timeout=300, check=False)
    return 0


def reachability_matrix() -> int:
    """Compile the deployment's declared reach graph and verify a live
    container honors both its one declared edge and its default deny
    (TDD-2.1.46)."""
    if platform.system() != "Linux":
        return report("linux_host")
    command = os.environ.get("RESEARCH_AGENT_CONTAINER_DOCKER")
    if not command:
        return report("explicit disposable Linux Docker command is required")
    from research_agent.platform.network import EgressManifest, compile_reachability

    token = uuid.uuid4().hex[:8]
    engine = Engine(tuple(shlex.split(command)), f"rareach{token}")
    bystander = f"research-agent-bystander-{token}"
    policy = compile_reachability((("storage", "postgres:5432"),), EgressManifest({}))
    try:
        with tempfile.TemporaryDirectory(prefix="research-agent-reachability-") as directory:
            fixture = Path(directory)
            start_stack(engine, fixture)
            storage_network = engine.project_resource("network", "storage")
            postgres_container = f"{engine.project}-postgres-1"
            storage_container = f"{engine.project}-storage-1"

            if not policy.allows("storage", "postgres:5432"):
                raise RuntimeError("reachability_matrix: compiled policy denies a live edge")
            if not reaches(engine, storage_container, "postgres", "5432"):
                raise Unavailable(
                    "storage_to_postgres is not live, so the matrix would prove nothing"
                )
            print("storage_to_postgres: reachable (declared edge holds)")

            engine.run("run", "--detach", "--name", bystander, PROBE_IMAGE, "sleep", "300")
            if policy.allows("bystander", "postgres:5432"):
                raise RuntimeError(
                    "reachability_matrix: policy wrongly admits an undeclared role"
                )
            postgres_address = address(engine, postgres_container, storage_network)
            if reaches(engine, bystander, postgres_address, "5432"):
                raise RuntimeError(
                    "bystander_to_postgres: an undeclared role reached a live destination"
                )
            print("bystander_to_postgres: denied (no compiled edge)")
            print("Collection reachability matrix probe passed")
    except Unavailable as error:
        return report(str(error))
    except RuntimeError as error:
        print(f"Collection boundary violated: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, KeyError, IndexError, json.JSONDecodeError) as error:
        return report(f"reachability_matrix ({error})")
    finally:
        engine.run("rm", "--force", bystander, check=False)
        engine.compose("down", "--volumes", "--remove-orphans", timeout=300, check=False)
    return 0


def persistence_replacement() -> int:
    """Recreate storage and PostgreSQL against their preserved volumes and
    verify one ledger record and one artifact survive byte-for-byte (TDD-2.1.45)."""
    if platform.system() != "Linux":
        return report("linux_host")
    command = os.environ.get("RESEARCH_AGENT_CONTAINER_DOCKER")
    if not command:
        return report("explicit disposable Linux Docker command is required")
    from research_agent.storage.persistence import compare_snapshots

    token = uuid.uuid4().hex[:8]
    engine = Engine(tuple(shlex.split(command)), f"rapersist{token}")
    marker = f"{ARTIFACT_ROOT}/persistence-marker"
    marker_value = secrets.token_hex(32)
    try:
        with tempfile.TemporaryDirectory(prefix="research-agent-persistence-") as directory:
            fixture = Path(directory)
            start_stack(engine, fixture)
            storage_network = engine.project_resource("network", "storage")
            storage_container = f"{engine.project}-storage-1"

            engine.run(
                "exec", storage_container, "sh", "-c", f"printf '%s' {marker_value} > {marker}"
            )
            before_artifact = _run_bytes((*engine.command, "exec", storage_container, "cat", marker))
            before_ledger = _run_in_storage_image(engine, fixture, storage_network, PERSIST_WRITE).strip()

            engine.compose("stop", "postgres", "storage", timeout=120)
            engine.compose("rm", "--force", "postgres", "storage")
            engine.compose("up", "--detach", "postgres")
            await_state(
                lambda: str(
                    engine.inspect("container", f"{engine.project}-postgres-1")["State"]["Health"]["Status"]
                ),
                "healthy",
                label="postgres",
            )
            engine.compose("up", "--detach", "storage")
            await_state(
                lambda: str(engine.inspect("container", storage_container)["State"]["Status"]),
                "running",
                label="storage",
            )

            after_artifact = _run_bytes((*engine.command, "exec", storage_container, "cat", marker))
            after_ledger = _run_in_storage_image(engine, fixture, storage_network, PERSIST_READ).strip()

            mismatches = compare_snapshots(
                {"artifact_marker": before_artifact, "ledger_record": before_ledger.encode()},
                {"artifact_marker": after_artifact, "ledger_record": after_ledger.encode()},
            )
            if mismatches:
                raise RuntimeError(f"persistence_replacement: {mismatches} changed after recreation")
            print(f"artifact_marker: preserved ({len(after_artifact)} bytes)")
            print(f"ledger_record: preserved ({after_ledger})")
            print("Collection persistence replacement probe passed")
    except Unavailable as error:
        return report(str(error))
    except RuntimeError as error:
        print(f"Collection boundary violated: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, KeyError, IndexError, json.JSONDecodeError) as error:
        return report(f"persistence_replacement ({error})")
    finally:
        engine.compose("down", "--volumes", "--remove-orphans", timeout=300, check=False)
    return 0


def full_gate() -> int:
    missing: list[str] = []
    if platform.system() != "Linux":
        missing.append("linux_host")
    evidence = os.environ.get("RESEARCH_AGENT_ISOLATION_EVIDENCE")
    if not evidence or not Path(evidence).is_file():
        missing.append("host_enforced_isolation_evidence")
    required = (
        "RESEARCH_AGENT_STORAGE_CONFIG",
        "RESEARCH_AGENT_POSTGRES_DATABASE_FILE",
        "RESEARCH_AGENT_POSTGRES_USER_FILE",
        "RESEARCH_AGENT_POSTGRES_PASSWORD_FILE",
    )
    missing.extend(name.lower() for name in required if not os.environ.get(name))
    if missing:
        print("Collection boundary unavailable: " + ", ".join(missing), file=sys.stderr)
        return 1
    try:
        run = subprocess.run
        run(("docker", "info"), check=True, capture_output=True, text=True)
        run(("docker", "compose", "-f", "compose.yaml", "config"), check=True, capture_output=True, text=True, cwd=ROOT)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Collection boundary unavailable: docker_runtime ({error})", file=sys.stderr)
        return 1
    print(
        "Collection boundary unavailable: host-network enforcement probes are "
        "unimplemented; the container matrix alone does not admit collection.",
        file=sys.stderr,
    )
    return 1


def report(message: str) -> int:
    print(f"Collection boundary unavailable: {message}", file=sys.stderr)
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worker-boundary", action="store_true")
    parser.add_argument("--secret-scan", action="store_true")
    parser.add_argument("--worker-image", action="store_true")
    parser.add_argument("--reachability-matrix", action="store_true")
    parser.add_argument("--persistence-replacement", action="store_true")
    arguments = parser.parse_args()
    if arguments.worker_boundary:
        return worker_boundary()
    if arguments.secret_scan:
        return secret_scan()
    if arguments.worker_image:
        return worker_image()
    if arguments.reachability_matrix:
        return reachability_matrix()
    if arguments.persistence_replacement:
        return persistence_replacement()
    return full_gate()


if __name__ == "__main__":
    raise SystemExit(main())
