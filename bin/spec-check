#!/usr/bin/env python3
"""Check current behavior requirements, their owners, tests and explicit gaps."""

from __future__ import annotations

import argparse
import ast
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

HEADING = re.compile(r"^## ([A-Z]{2}-\d{2}) (.+)$", re.M)
OLD_REQUIREMENT = re.compile(r"^\*\*([A-Z]{2}-\d{2})\.\*\*", re.M)
FIELD = re.compile(
    r"^- (Behavior|Constraints|Contracts|Code|Tests|Gap|Retired): (.+)$", re.M
)
LINK = re.compile(r"\[[^\]\n]+\]\(([^)\n]+)\)")
REQUIRED = {"Behavior", "Code", "Tests", "Gap"}
FIELD_ORDER = ("Behavior", "Constraints", "Contracts", "Code", "Tests", "Gap")


def reasons(text: str, kind: str) -> dict[str, str]:
    return {
        match[1]: match[2]
        for match in re.finditer(
            r"^" + kind + r" ((?:SDD-)?[A-Z]{2}-\d{2}|TDD-\d+(?:\.\d+)+): (.+)$",
            text,
            re.M,
        )
        if len(match[2].strip().rstrip(".!?").split()) >= 3
        and match[2].strip().rstrip(".!?").lower()
        not in {"no reason given", "to be determined"}
    }


def requirements(text: str) -> list[tuple[str, str]]:
    headings = list(HEADING.finditer(text))
    return [
        (
            heading[1],
            text[
                heading.end() : headings[index + 1].start()
                if index + 1 < len(headings)
                else len(text)
            ],
        )
        for index, heading in enumerate(headings)
    ]


def symbol_exists(path: Path, symbol: str) -> bool:
    text = path.read_text()
    if path.suffix == ".py" or text.startswith("#!/usr/bin/env python"):
        body = ast.parse(text).body
        for part in symbol.split("."):
            definition = next(
                (
                    node
                    for node in body
                    if isinstance(
                        node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)
                    )
                    and node.name == part
                ),
                None,
            )
            if definition is None:
                return False
            body = definition.body
        return True
    return bool(
        re.search(
            r"\b(?:function|class|const|let|type|interface)\s+"
            + re.escape(symbol)
            + r"\b",
            text,
        )
    )


def is_none(value: str) -> bool:
    return value.strip().rstrip(".!?").strip().lower() == "none"


def collected_test_exists(path: Path, symbol: str) -> bool:
    parts = symbol.split(".")
    if not parts[-1].startswith("test_"):
        return False
    body = ast.parse(path.read_text()).body
    for name in parts[:-1]:
        definition = next(
            (
                node
                for node in body
                if isinstance(node, ast.ClassDef) and node.name == name
            ),
            None,
        )
        if definition is None or not name.startswith("Test"):
            return False
        if any(
            isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
            and node.name in {"__init__", "__new__"}
            for node in definition.body
        ):
            return False
        body = definition.body
    return any(
        isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        and node.name == parts[-1]
        for node in body
    )


SDD_TRACE = re.compile(
    r"^<!--\s*id:\s*(SDD-[A-Z]{2}-\d{2})\s*\|\s*tdd:\s*([^|]+)\|\s*status:\s*([^|]+?)\s*-->\s*$",
    re.M,
)
TDD_HEADING = re.compile(r"^#### (TDD-\d+(?:\.\d+)+) (.+)$", re.M)
TDD_TRACE = re.compile(
    r"^<!--\s*id:\s*(TDD-\d+(?:\.\d+)+)\s*\|\s*implements:\s*([^|]+?)\s*\|\s*code:\s*([^|]+?)\s*\|\s*tests:\s*([^|]+?)\s*\|\s*status:\s*([^|]+?)\s*-->\s*$",
    re.M,
)
STATUSES = {"implemented", "pending", "deviation"}


def prose(text: str) -> str:
    lines: list[str] = []
    fence = ""
    for line in text.splitlines(keepends=True):
        marker = re.match(r"^\s*(`{3,}|~{3,})", line)
        if marker:
            if not fence:
                fence = marker[1]
            elif marker[1][0] == fence[0] and len(marker[1]) >= len(fence):
                fence = ""
            lines.append("\n")
        else:
            lines.append("\n" if fence else line)
    return "".join(lines)


def fulfillment(root: Path, docs: Path, since: str) -> list[str]:
    findings: list[str] = []
    sdd = prose((docs / "SDD.md").read_text())
    tdd_path = docs / "TDD.md"
    if not tdd_path.is_file():
        return findings
    tdd = prose(tdd_path.read_text())
    features = dict(requirements(sdd))
    items: dict[str, tuple[str, str, str, str]] = {}
    headings = list(TDD_HEADING.finditer(tdd))
    if not headings:
        return ["TDD.md: missing technical fulfillment contracts"]
    previous: tuple[int, ...] = ()
    for index, heading in enumerate(headings):
        identifier = heading[1]
        prefix = f"TDD.md: {identifier}"
        number = tuple(int(part) for part in identifier.removeprefix("TDD-").split("."))
        if previous and number < previous:
            findings.append(f"{prefix}: contract IDs must ascend in reading order")
        previous = number
        anchor = identifier.lower()
        anchors = list(
            re.finditer(r'<a\s+id="' + re.escape(anchor) + r'"\s*></a>', tdd)
        )
        if len(anchors) != 1:
            findings.append(f"{prefix}: needs exactly one explicit anchor {anchor}")
        elif not re.search(
            r'<a\s+id="' + re.escape(anchor) + r'"\s*></a>\s*$', tdd[: heading.start()]
        ):
            findings.append(f"{prefix}: explicit anchor must precede its heading")
        body = tdd[
            heading.end() : headings[index + 1].start()
            if index + 1 < len(headings)
            else len(tdd)
        ]
        traces = list(TDD_TRACE.finditer(body))
        if identifier in items:
            findings.append(f"{prefix}: duplicate contract")
        if len(traces) != 1:
            findings.append(f"{prefix}: needs exactly one fulfillment trace")
            continue
        trace = traces[0]
        actual, implements, code, tests, status = (
            value.strip() for value in trace.groups()
        )
        if actual != identifier:
            findings.append(f"{prefix}: trace id differs from heading")
        if status not in STATUSES:
            findings.append(f"{prefix}: unknown status {status}")
        if implements not in features:
            findings.append(f"{prefix}: unknown SDD requirement {implements}")
        content = re.sub(r"<!--.*?-->", "", body, flags=re.S)
        content = re.sub(r"^#{1,6} .*?$", "", content, flags=re.M).strip()
        if len(content.split()) < 12 or content.rstrip(".!?").lower() in {
            "todo",
            "tbd",
            "pending",
            "unknown",
            "n/a",
            "none",
        }:
            findings.append(f"{prefix}: missing substantive contract body")
        if status in {"pending", "deviation"} and any(
            is_none(gap)
            for gap in re.findall(r"^(?:- )?Gap:\s*(.+)$", content, re.M | re.I)
        ):
            findings.append(f"{prefix}: {status} contract cannot claim Gap: None.")
        items[identifier] = (implements, status, code, tests)
        for kind, target in (("code", code), ("tests", tests)):
            if is_none(target):
                if kind == "code" or status == "implemented":
                    findings.append(f"{prefix}: {status} contract needs a {kind} owner")
                continue
            filename, _, symbol = target.partition("#")
            owner = root / filename
            if not owner.is_file():
                findings.append(f"{prefix}: missing {kind} owner {target}")
                continue
            if not owner.resolve().is_relative_to(root.resolve()):
                findings.append(f"{prefix}: {kind} owner must be inside the repository")
                continue
            if kind == "tests" and not (
                (
                    filename.startswith("tests/")
                    and Path(filename).name.startswith("test_")
                    and filename.endswith(".py")
                )
                or ".test." in filename
                or (filename.startswith("bin/") and symbol == "self_test")
            ):
                findings.append(
                    f"{prefix}: tests owner is not an executable test: {target}"
                )
            if (
                kind == "tests"
                and owner.suffix == ".py"
                and symbol
                and not collected_test_exists(owner, symbol)
            ):
                findings.append(
                    f"{prefix}: tests symbol must name a collected test: {target}"
                )
            if symbol and not symbol_exists(owner, symbol):
                findings.append(f"{prefix}: missing {kind} symbol {target}")
    for identifier, body in features.items():
        prefix = f"SDD.md: {identifier}"
        fields = {match[1]: match[2].strip() for match in FIELD.finditer(body)}
        if "Retired" in fields:
            continue
        traces = list(SDD_TRACE.finditer(body))
        if len(traces) != 1:
            findings.append(f"{prefix}: needs exactly one requirement trace")
            continue
        trace = traces[0]
        actual, targets, status = (value.strip() for value in trace.groups())
        if actual != f"SDD-{identifier}":
            findings.append(f"{prefix}: trace id differs from heading")
        linked = [target.strip() for target in targets.split(",")]
        if len(linked) != len(set(linked)):
            findings.append(f"{prefix}: duplicate fulfillment link")
        for target in linked:
            if target not in items:
                findings.append(f"{prefix}: unknown TDD contract {target}")
            elif items[target][0] != identifier:
                findings.append(
                    f"{prefix}: {target} implements {items[target][0]}, not {identifier}"
                )
        backlinks = {key for key, item in items.items() if item[0] == identifier}
        if set(linked) != backlinks:
            findings.append(
                f"{prefix}: fulfillment links and TDD implements backlinks differ"
            )
        contract_fields = re.findall(r"^- Contracts: (.+)$", body, re.M)
        if len(contract_fields) != 1:
            findings.append(f"{prefix}: needs exactly one Contracts field")
        elif set(re.findall(r"\[([^]]+)\]\(TDD\.md#([^)]*)\)", contract_fields[0])) != {
            (target, target.lower()) for target in linked
        }:
            findings.append(
                f"{prefix}: Contracts links must match trace targets and anchors"
            )
        statuses = {items[target][1] for target in linked if target in items}
        expected = (
            "pending"
            if "pending" in statuses
            else "deviation"
            if "deviation" in statuses
            else "implemented"
        )
        if status not in STATUSES:
            findings.append(f"{prefix}: unknown status {status}")
        elif status != expected:
            findings.append(
                f"{prefix}: status must be {expected} from fulfillment contracts"
            )
        if status in {"pending", "deviation"} and is_none(fields.get("Gap", "")):
            findings.append(f"{prefix}: {status} requirement must state an exact gap")
        if status == "implemented" and not is_none(fields.get("Gap", "")):
            findings.append(f"{prefix}: implemented requirement must have Gap: None.")
    for name, content in (("SDD.md", sdd), ("TDD.md", tdd)):
        content = re.sub(r"<!--.*?-->", "", content, flags=re.S)
        content = re.sub(r"^(?:Reserved|Retired) [^:\n]+: .+$", "", content, flags=re.M)
        for reference in set(re.findall(r"\b[A-Z]{2}-\d{2}\b", content)):
            if reference not in features:
                findings.append(f"{name}: unknown requirement reference {reference}")
        for reference in set(re.findall(r"\bTDD-\d+(?:\.\d+)+\b", content)):
            if reference not in items:
                findings.append(f"{name}: unknown contract reference {reference}")
    if since:
        baseline = subprocess.run(
            ["git", "show", f"{since}:TDD.md"], cwd=root, text=True, capture_output=True
        )
        if baseline.returncode:
            findings.append(f"TDD.md: cannot compare baseline {since}")
        else:
            for identifier in sorted(
                {match[1] for match in TDD_HEADING.finditer(prose(baseline.stdout))}
                - items.keys()
            ):
                if identifier not in reasons(tdd, "Retired"):
                    findings.append(
                        f"TDD.md: {identifier}: removed stable fulfillment contract without a current retirement reason"
                    )
    return findings


def check(root: Path, since: str = "", docs: Path | None = None) -> list[str]:
    findings: list[str] = []
    docs = root if docs is None else docs
    path = docs / "SDD.md"
    if not path.is_file():
        return ["SDD.md: missing current specification"]
    text = prose(path.read_text())
    entries = requirements(text)
    if not entries:
        return ["SDD.md: no current requirements"]
    seen: set[str] = set()
    areas: dict[str, list[int]] = {}
    area_order: list[str] = []
    for identifier, _ in entries:
        area, number = identifier.split("-")
        if area_order and area_order[-1] != area and area in area_order:
            findings.append(
                f"SDD.md: {identifier}: requirement area must be contiguous"
            )
        area_order.append(area)
        numbers = areas.setdefault(area, [])
        if numbers and int(number) < numbers[-1]:
            findings.append(
                f"SDD.md: {identifier}: requirement IDs must ascend within their area"
            )
        numbers.append(int(number))
    reservations = reasons(text, "Reserved")
    retirements = reasons(text, "Retired")
    for area, numbers in areas.items():
        for number in range(1, max(numbers) + 1):
            identifier = f"{area}-{number:02d}"
            if (
                number not in numbers
                and identifier not in reservations
                and f"SDD-{identifier}" not in retirements
            ):
                findings.append(
                    f"SDD.md: {identifier}: numbering gap needs a current reservation reason"
                )
    for identifier, body in entries:
        prefix = f"SDD.md: {identifier}"
        if identifier in seen:
            findings.append(f"{prefix}: duplicate requirement")
        seen.add(identifier)
        fields: dict[str, str] = {}
        labels = [match[1] for match in FIELD.finditer(body) if match[1] != "Retired"]
        if labels != sorted(labels, key=FIELD_ORDER.index):
            findings.append(f"{prefix}: feature fields are out of order")
        for match in FIELD.finditer(body):
            if match[1] in fields:
                findings.append(f"{prefix}: duplicate {match[1]} field")
            fields[match[1]] = match[2].strip()
        if "Retired" in fields:
            if fields.keys() != {"Retired"}:
                findings.append(
                    f"{prefix}: retired requirement must contain only its retirement reason"
                )
            if len(fields["Retired"].split()) < 3:
                findings.append(f"{prefix}: state the retirement reason")
            continue
        for missing in sorted(REQUIRED - fields.keys()):
            findings.append(f"{prefix}: missing {missing} field")
        for field in ("Behavior", "Gap"):
            if fields.get(field, "").rstrip(".!?").lower() in {
                "todo",
                "tbd",
                "pending",
                "unknown",
                "n/a",
            }:
                findings.append(f"{prefix}: {field} must state exact behavior or gaps")
        if "Behavior" in fields and not re.search(
            r"\bmust(?: not)?\b", body.split("\n- ", 1)[0]
        ):
            findings.append(f"{prefix}: state required behavior with must or must not")
        for field in ("Code", "Tests"):
            value = fields.get(field, "")
            links = LINK.findall(value)
            if value and not links:
                if not is_none(value) or is_none(fields.get("Gap", "")):
                    findings.append(
                        f"{prefix}: {field} needs owner links, or None. with an explicit gap"
                    )
            for target in links:
                filename, _, symbol = target.partition("#")
                owner = root / filename
                if not owner.is_file():
                    findings.append(f"{prefix}: missing {field} owner {target}")
                    continue
                if not owner.resolve().is_relative_to(root.resolve()):
                    findings.append(
                        f"{prefix}: {field} owner must be inside the repository"
                    )
                    continue
                if field == "Tests" and not (
                    (
                        filename.startswith("tests/")
                        and Path(filename).name.startswith("test_")
                        and filename.endswith(".py")
                    )
                    or ".test." in filename
                    or (filename.startswith("bin/") and symbol == "self_test")
                ):
                    findings.append(
                        f"{prefix}: Tests must link to executable tests: {target}"
                    )
                if (
                    field == "Tests"
                    and owner.suffix == ".py"
                    and symbol
                    and not collected_test_exists(owner, symbol)
                ):
                    findings.append(
                        f"{prefix}: Tests symbol must name a collected test: {target}"
                    )
                if symbol and not symbol_exists(owner, symbol):
                    findings.append(f"{prefix}: missing {field} symbol {target}")
    if not (docs / "TDD.md").is_file():
        findings.append("TDD.md: missing architecture and contract index")
    if since:
        result = subprocess.run(
            ["git", "show", f"{since}:SDD.md"],
            cwd=root,
            text=True,
            capture_output=True,
        )
        if result.returncode:
            findings.append(f"SDD.md: cannot compare baseline {since}")
        else:
            baseline = {identifier for identifier, _ in requirements(result.stdout)}
            baseline.update(OLD_REQUIREMENT.findall(result.stdout))
            for identifier in sorted(baseline - seen):
                if f"SDD-{identifier}" not in retirements:
                    findings.append(
                        f"SDD.md: {identifier}: removed without an explicit Retired reason"
                    )
    findings.extend(fulfillment(root, docs, since))
    return findings


def self_test() -> int:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / "tests").mkdir()
        (root / "owner.py").write_text("def read():\n    return 1\n")
        (root / "tests/test_owner.py").write_text(
            "def test_read():\n    assert 1 == 1\n\ndef helper():\n    return 1\n"
            "\nclass Helper:\n    def test_read(self):\n        assert 1 == 1\n"
            "\nclass TestOwner:\n    def test_read(self):\n        assert 1 == 1\n"
            "\nclass TestInitialized:\n    def __init__(self):\n        pass\n    def test_read(self):\n        assert 1 == 1\n"
            "\nclass TestAllocated:\n    def __new__(cls):\n        return super().__new__(cls)\n    def test_read(self):\n        assert 1 == 1\n"
            "\ndef outer():\n    def test_read():\n        assert 1 == 1\n"
        )
        technical = (
            '# Architecture\n\n<a id="tdd-1.1.1"></a>\n\n#### TDD-1.1.1 Read stored data\n'
            "<!-- id: TDD-1.1.1 | implements: CP-01 | code: owner.py#read | tests: tests/test_owner.py#test_read | status: implemented -->\n\n"
            "The reader returns the stored numeric value without changing state. Missing data is refused. The read test checks the returned value.\n"
        )
        (root / "TDD.md").write_text(technical)
        good = (
            "# Current specification\n\n## CP-01 Read stored data\n\n"
            "The service must return stored data.\n\n"
            "<!-- id: SDD-CP-01 | tdd: TDD-1.1.1 | status: implemented -->\n\n"
            "- Behavior: A read returns the stored value.\n"
            "- Contracts: [TDD-1.1.1](TDD.md#tdd-1.1.1).\n"
            "- Code: [Reader](owner.py#read).\n"
            "- Tests: [Read behavior](tests/test_owner.py#test_read).\n"
            "- Gap: None.\n"
        )
        cases = (
            (good, ""),
            (good.replace("- Gap: None.\n", ""), "missing Gap"),
            (good + good, "duplicate requirement"),
            (good.replace("owner.py#read", "missing.py"), "missing Code owner"),
            (good.replace("#read", "#missing"), "missing Code symbol"),
            (good.replace("#test_read", "#test_missing"), "missing Tests symbol"),
            (
                good.replace(
                    "[Read behavior](tests/test_owner.py#test_read).", "None."
                ),
                "Tests needs owner links",
            ),
            (good.replace("- Gap: None.", "- Gap: pending"), "Gap must state exact"),
            (
                good.replace(
                    "- Behavior: A read returns the stored value.", "- Behavior: TBD."
                ),
                "Behavior must state exact",
            ),
            (
                good.replace(
                    "The service must return stored data.",
                    "A description.\n\n- Constraints: The type must be numeric.",
                ),
                "state required behavior",
            ),
            (
                good.replace("#test_read", "#helper"),
                "Tests symbol must name a collected test",
            ),
            (
                good.replace("- Gap: None.", "- Gap: None.\n- Gap: Missing behavior."),
                "duplicate Gap",
            ),
            (
                good.replace("tests/test_owner.py#test_read", "owner.py#read"),
                "Tests must link",
            ),
            (
                good.replace("## CP-01 Read stored data", "## CP-01 Retired").replace(
                    good.split("\n\n", 2)[2], "- Retired: Removed obsolete behavior.\n"
                ),
                "",
            ),
        )
        for content, expected in cases:
            (root / "SDD.md").write_text(content)
            findings = check(root)
            if expected:
                assert any(expected in finding for finding in findings), (
                    expected,
                    findings,
                )
            else:
                assert not findings, findings
        relational_cases = (
            (
                good,
                technical
                + technical.replace("TDD-1.1.1", "TDD-1.1.0").replace(
                    "tdd-1.1.1", "tdd-1.1.0"
                ),
                "contract IDs must ascend",
            ),
            (
                good.replace(
                    "- Behavior: A read returns the stored value.\n", ""
                ).replace(
                    "- Gap: None.",
                    "- Gap: None.\n- Behavior: A read returns the stored value.",
                ),
                technical,
                "feature fields are out of order",
            ),
            (
                good.replace("CP-01", "CP-02"),
                technical.replace("CP-01", "CP-02"),
                "numbering gap needs a current reservation reason",
            ),
            (
                good.replace("CP-01", "CP-02") + "\nReserved CP-01: TBD.\n",
                technical.replace("CP-01", "CP-02"),
                "numbering gap needs a current reservation reason",
            ),
            (
                good.replace("CP-01", "CP-02") + "\n" + good,
                technical,
                "requirement IDs must ascend",
            ),
            *(
                (
                    good.replace("status: implemented", "status: pending").replace(
                        "Gap: None.", f"Gap: {gap}"
                    ),
                    technical.replace("status: implemented", "status: pending"),
                    "pending requirement must state an exact gap",
                )
                for gap in ("None", "none.", "NONE.")
            ),
            *(
                (
                    good.replace("#test_read", f"#{symbol}"),
                    technical,
                    "Tests symbol must name a collected test",
                )
                for symbol in (
                    "Helper.test_read",
                    "TestInitialized.test_read",
                    "TestAllocated.test_read",
                    "outer.test_read",
                )
            ),
            (
                good,
                technical.replace("#test_read", "#Helper.test_read"),
                "tests symbol must name a collected test",
            ),
            (
                good,
                technical.replace('<a id="tdd-1.1.1"></a>', ""),
                "needs exactly one explicit anchor",
            ),
            (
                good,
                technical.replace('id="tdd-1.1.1"', 'id="tdd-1.1.2"'),
                "needs exactly one explicit anchor",
            ),
            (
                good,
                technical.replace(
                    '<a id="tdd-1.1.1"></a>',
                    '<a id="tdd-1.1.1"></a>\n<a id="tdd-1.1.1"></a>',
                ),
                "needs exactly one explicit anchor",
            ),
            (
                good,
                technical.replace('<a id="tdd-1.1.1"></a>', "").rstrip()
                + '\n<a id="tdd-1.1.1"></a>\n',
                "explicit anchor must precede its heading",
            ),
            (
                good,
                technical.replace("status: implemented", "status: invented"),
                "unknown status invented",
            ),
            (
                good,
                technical.replace("id: TDD-1.1.1", "id: TDD-1.1.2"),
                "trace id differs from heading",
            ),
            (
                good.replace("id: SDD-CP-01", "id: SDD-CP-02"),
                technical,
                "trace id differs from heading",
            ),
            (
                good,
                technical.replace("<!-- id:", "broken id:"),
                "needs exactly one fulfillment trace",
            ),
            (
                good,
                technical.replace("status: implemented", "status: pending")
                + "\nGap: None.\n",
                "pending contract cannot claim Gap: None.",
            ),
            (
                good.replace("status: implemented", "status: pending"),
                technical,
                "status must be implemented",
            ),
            (
                good.replace("status: implemented", "status: pending"),
                technical.replace("status: implemented", "status: pending"),
                "pending requirement must state an exact gap",
            ),
            (
                good,
                technical.replace("implements: CP-01", "implements: CP-02"),
                "unknown SDD requirement",
            ),
            (
                good.replace("tdd: TDD-1.1.1", "tdd: TDD-1.1.2"),
                technical,
                "unknown TDD contract",
            ),
            (
                good.replace("tdd: TDD-1.1.1", "tdd: TDD-1.1.1, TDD-1.1.1"),
                technical,
                "duplicate fulfillment link",
            ),
            (
                good.replace("#tdd-1.1.1", "#missing"),
                technical,
                "Contracts links must match",
            ),
            (good, technical + technical, "duplicate contract"),
            (
                good,
                technical.replace("code: owner.py#read", "code: owner.py#missing"),
                "missing code symbol",
            ),
            (
                good,
                technical.replace(
                    "tests: tests/test_owner.py#test_read", "tests: none"
                ),
                "implemented contract needs a tests owner",
            ),
            (
                good,
                technical.rsplit("\n\n", 1)[0] + "\n\nTBD.\n",
                "missing substantive contract body",
            ),
            (good, technical + "\nSee CP-99.\n", "unknown requirement reference CP-99"),
            (
                good,
                technical + "\nSee `CP-99`.\n",
                "unknown requirement reference CP-99",
            ),
            (
                good,
                technical + "\nSee `TDD-9.9.9`.\n",
                "unknown contract reference TDD-9.9.9",
            ),
            (
                good + "\nSee `CP-99`.\n",
                technical,
                "unknown requirement reference CP-99",
            ),
            (
                good + "\nSee `TDD-9.9.9`.\n",
                technical,
                "unknown contract reference TDD-9.9.9",
            ),
            (
                good,
                technical + "\nSee TDD-9.9.9.\n",
                "unknown contract reference TDD-9.9.9",
            ),
        )
        for current, contracts, expected in relational_cases:
            (root / "SDD.md").write_text(current)
            (root / "TDD.md").write_text(contracts)
            findings = check(root)
            assert any(expected in finding for finding in findings), (
                expected,
                findings,
            )
        (root / "SDD.md").write_text(
            good.replace("CP-01", "CP-02")
            + "\nReserved CP-01: Reserved for retired ingestion behavior.\n"
        )
        (root / "TDD.md").write_text(technical.replace("CP-01", "CP-02"))
        assert not check(root)
        for gap in ("None", "none.", "NONE."):
            (root / "SDD.md").write_text(good.replace("Gap: None.", f"Gap: {gap}"))
            (root / "TDD.md").write_text(technical)
            assert not check(root)
        for sentinel in ("None", "none.", "NONE."):
            (root / "SDD.md").write_text(
                good.replace("status: implemented", "status: pending")
                .replace("Gap: None.", "Gap: The read behavior test is absent.")
                .replace("[Read behavior](tests/test_owner.py#test_read).", sentinel)
            )
            (root / "TDD.md").write_text(
                technical.replace("status: implemented", "status: pending").replace(
                    "tests: tests/test_owner.py#test_read", f"tests: {sentinel}"
                )
            )
            assert not check(root)
        (root / "SDD.md").write_text(good.replace("#test_read", "#TestOwner.test_read"))
        (root / "TDD.md").write_text(
            technical.replace("#test_read", "#TestOwner.test_read")
        )
        assert not check(root)
        (root / "SDD.md").write_text(
            good + "\n```md\nSee `CP-99` and `TDD-9.9.9`.\n```\n"
        )
        (root / "TDD.md").write_text(
            technical
            + "\n```md\n"
            + technical
            + "\nSee `CP-99` and `TDD-9.9.9`.\n```\n"
        )
        assert not check(root)
        (root / "bin").mkdir()
        (root / "bin/check").write_text(
            "#!/usr/bin/env python3\ndef self_test():\n    return 0\n"
        )
        assert symbol_exists(root / "bin/check", "self_test")
        assert not symbol_exists(root / "bin/check", "missing")
        (root / "SDD.md").write_text(good)
        (root / "TDD.md").write_text(technical)
        subprocess.run(["git", "init", "-q", str(root)], check=True)
        subprocess.run(["git", "add", "."], cwd=root, check=True)
        subprocess.run(
            [
                "git",
                "-c",
                "user.name=spec-check",
                "-c",
                "user.email=spec@check",
                "commit",
                "-qm",
                "fixture",
            ],
            cwd=root,
            check=True,
        )
        assert not check(root, "HEAD")
        changed = technical.replace("TDD-1.1.1", "TDD-1.1.2").replace(
            "tdd-1.1.1", "tdd-1.1.2"
        )
        (root / "SDD.md").write_text(
            good.replace("TDD-1.1.1", "TDD-1.1.2").replace("tdd-1.1.1", "tdd-1.1.2")
        )
        (root / "TDD.md").write_text(
            changed + "\nRetired TDD-1.1.1: Replaced by the current reader contract.\n"
        )
        assert not check(root, "HEAD"), check(root, "HEAD")
        (root / "TDD.md").write_text(changed + "\nRetired TDD-1.1.1: TBD.\n")
        assert any(
            "removed stable fulfillment" in finding for finding in check(root, "HEAD")
        )
        (root / "SDD.md").write_text(
            good.replace("CP-01", "CP-02")
            + "\nRetired SDD-CP-01: Replaced by the current read behavior.\n"
        )
        (root / "TDD.md").write_text(technical.replace("CP-01", "CP-02"))
        assert not check(root, "HEAD"), check(root, "HEAD")
        (root / "SDD.md").write_text(good)
        (root / "TDD.md").write_text(technical.replace("TDD-1.1.1", "TDD-1.1.2"))
        assert any(
            "removed stable fulfillment" in finding for finding in check(root, "HEAD")
        )
        (root / "TDD.md").write_text(technical)
        (root / "SDD.md").write_text(good.replace("CP-01", "CP-02"))
        assert any("removed without" in finding for finding in check(root, "HEAD"))
        assert any(
            "cannot compare" in finding for finding in check(root, "missing-revision")
        )
    print(
        "Specification self-test: valid requirements pass; missing gaps, owners, tests, duplicates and silent removal fail."
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--spec-dir", default=".")
    parser.add_argument(
        "--repo-root",
        help="implementation owners and git baseline root; defaults to --spec-dir",
    )
    parser.add_argument("--since", default="")
    parser.add_argument("--strict", action="store_true", help="all findings are errors")
    parser.add_argument("--stats", action="store_true")
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    docs = Path(args.spec_dir)
    root = Path(args.repo_root) if args.repo_root else docs
    findings = check(root, args.since, docs)
    if args.as_json:
        print(json.dumps({"findings": findings, "errors": len(findings)}, indent=2))
    else:
        for finding in findings:
            print(finding)
        if args.stats and (docs / "SDD.md").exists():
            entries = requirements((docs / "SDD.md").read_text())
            gaps = sum(
                not any(
                    match[1] == "Gap" and is_none(match[2])
                    for match in FIELD.finditer(body)
                )
                and "- Retired:" not in body
                for _, body in entries
            )
            print(f"{len(entries)} requirements; {gaps} with explicit gaps")
        print(f"Current specification: {len(findings)} errors")
    return int(bool(findings))


if __name__ == "__main__":
    sys.exit(main())
