#!/usr/bin/env python3
"""Run the repository checks used locally and by CI."""
import argparse
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def run(*args):
    subprocess.run(args, cwd=ROOT, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--issues', action='store_true')
    parser.add_argument('--since')
    args = parser.parse_args()
    spec_args = ['--strict']
    if args.issues:
        spec_args.append('--issues')
    if args.since:
        spec_args.extend(['--since', args.since])
    run(sys.executable, 'bin/spec-check', *spec_args)
    run(sys.executable, 'bin/spec-check', '--self-test')
    if (ROOT / 'src').exists() or (ROOT / 'pyproject.toml').exists():
        for name in ('pyproject.toml', 'uv.lock', 'src', 'tests'):
            if not (ROOT / name).exists():
                raise RuntimeError(f'Application checks require {name}')
        run('uv', 'run', '--locked', 'ruff', 'check', 'src', 'tests')
        run('uv', 'run', '--locked', 'ruff', 'format', '--check', 'src', 'tests')
        run('uv', 'run', '--locked', 'mypy', '--strict', 'src')
        run('uv', 'run', '--locked', 'pytest', '--require-postgres')
    if (ROOT / 'front-end' / 'package.json').exists():
        run(sys.executable, 'bin/check-front-end')
        run(sys.executable, 'bin/check-front-end', '--self-test')
    if not (ROOT / 'src').exists() and not (ROOT / 'pyproject.toml').exists():
        print('Specification checks complete; no application source exists yet.')


if __name__ == '__main__':
    try:
        main()
    except (subprocess.CalledProcessError, OSError, RuntimeError) as exc:
        print(f'Check failed: {exc}', file=sys.stderr)
        sys.exit(1)
